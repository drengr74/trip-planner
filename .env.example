# Скопируйте этот файл в .env и впишите свой ключ ProxyAPI.
# Настоящий ключ сюда не кладите: файл .env.example можно хранить в git.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
# Идентификатор из каталога ProxyAPI в виде «вендор/модель».
OPENAI_MODEL=openai/gpt-4o-mini

# OSM: название приложения и контакт (email или URL).
# Пример: trip-planner/0.1 (you@example.com)
OSM_USER_AGENT=
# По желанию свои инстансы; иначе публичные сервисы.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
# Радиус поиска достопримечательностей вокруг центра, метры.
OSM_SEARCH_RADIUS_M=30000
